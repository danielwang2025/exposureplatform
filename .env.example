# Supabase project (Project Settings → API). For local dev run `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Public origin used in email links. Optional locally (falls back to the request host).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only Supabase key (Project Settings → API → secret key). Never expose to the browser.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Mux video (optional — video uploads are hidden until all of these are set).
# Access token: Settings → Access Tokens (Mux Video read+write).
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
# Webhook signing secret: Settings → Webhooks, URL https://<your-domain>/api/webhooks/mux
MUX_WEBHOOK_SECRET=
# Signing key for private playback: Settings → Signing Keys (private key is base64).
MUX_SIGNING_KEY_ID=
MUX_SIGNING_KEY_PRIVATE=

# Outgoing email over SMTP (invitations). Optional: without it, owners copy invite links.
# Local Mailpit: smtp://127.0.0.1:54325   Resend: smtps://resend:re_xxx@smtp.resend.com:465
SMTP_URL=
EMAIL_FROM="Sprout <hello@example.com>"

# Protects /api/cron/cleanup. Vercel Cron sends it automatically when set.
CRON_SECRET=
